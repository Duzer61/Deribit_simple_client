# Deribit index price tracker — пример переменных окружения.
# Скопируйте в .env и измените значения. Реальные секреты в репозитории не хранятся.
# Значения ниже — локальные демонстрационные, они не предназначены для production.

# --- PostgreSQL (asyncpg) ---
# Локальная разработка: порт контейнера postgres из compose.yaml проброшен на 55432.
DATABASE_URL=postgresql+asyncpg://deribit:deribit@localhost:55432/deribit_tracker
# Отдельная база для integration-тестов (не рабочая).
TEST_DATABASE_URL=postgresql+asyncpg://deribit:deribit@localhost:55432/deribit_tracker_test

# Параметры контейнера PostgreSQL (используются сервисом postgres в compose.yaml).
POSTGRES_USER=deribit
POSTGRES_PASSWORD=deribit
POSTGRES_DB=deribit_tracker

# --- Celery ---
# Локальная разработка: порт контейнера redis из compose.yaml проброшен на 56379.
# Внутри compose используется полное имя сервиса: redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:56379/0

# --- Deribit ---
# Production public API. Для testnet нужно осознанно заменить хост на test.deribit.com.
DERIBIT_BASE_URL=https://www.deribit.com/api/v2
HTTP_TIMEOUT_SECONDS=10
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_BACKOFF_SECONDS=0.5
HTTP_RETRY_MAX_AFTER_SECONDS=5

# --- Сбор и логирование ---
COLLECT_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
